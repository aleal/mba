# Porta HTTP (default 3000)
PORT=3000
# Caminho do SQLite; ':memory:' recria o banco com seeds a cada boot (default)
DB_PATH=:memory:
# Token exigido no header X-Admin-Token das rotas administrativas.
# Vazio = rotas administrativas sempre respondem 403.
ADMIN_TOKEN=troque-por-um-token-aleatorio
# Chave do gateway de pagamento
PAYMENT_GATEWAY_KEY=
# debug | info | warn | error
LOG_LEVEL=info
