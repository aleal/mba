# Copie para .env e ajuste. Nunca versione o .env com valores reais.

# Obrigatória em produção (assina os tokens de login). Sem ela, uma chave aleatória é gerada a cada boot.
SECRET_KEY=
DATABASE_URL=sqlite:///tasks.db

HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false
# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Validade do token de login (segundos)
TOKEN_MAX_AGE_SECONDS=28800

# Notificações por e-mail (desligadas por padrão: só registram no log)
NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
