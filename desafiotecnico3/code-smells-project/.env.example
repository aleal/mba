# Copie para .env e exporte as variáveis (ex.: `set -a; . ./.env; set +a`).
# Nenhum valor abaixo é real: gere os seus.

# Chave de assinatura do Flask. Sem ela, uma chave aleatória é gerada a cada boot.
SECRET_KEY=troque-por-um-valor-aleatorio

# Servidor
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false
LOG_LEVEL=INFO
APP_ENV=desenvolvimento

# Banco SQLite
DATABASE_PATH=loja.db
# Cria produtos e clientes de exemplo no primeiro boot
SEED_DEMO_DATA=true
# Senha do usuário admin@loja.com criado no seed (vazio = senha aleatória, não divulgada)
SEED_ADMIN_PASSWORD=

# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:5000

# Rotas /admin/*: exigem o header X-Admin-Token com este valor (vazio = sempre 403)
ADMIN_TOKEN=
# Habilitam as operações administrativas (desligadas por padrão)
ENABLE_ADMIN_RESET=false
ENABLE_ADMIN_QUERY=false
